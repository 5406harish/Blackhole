{
  "manifest_version": 3,
  "name": "Black Hole",
  "version": "1.0.0",
  "description": "Save groups of Chrome tabs as reusable browser workspaces.",
  "permissions": ["tabs", "storage"],
  "action": {
    "default_title": "Black Hole",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "commands": {
    "open-capsule": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "MacCtrl+Shift+C"
      },
      "description": "Open Black Hole"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
